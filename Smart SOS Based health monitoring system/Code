// ============================================================
// MPU WRITE
// ============================================================

bool mpuWriteRegister(
    uint8_t reg,
    uint8_t value
)
{
    Wire.beginTransmission(MPU_ADDR);

    Wire.write(reg);
    Wire.write(value);

    return Wire.endTransmission() == 0;
}

// ============================================================
// MPU READ
// ============================================================

bool mpuReadRegisters(
    uint8_t reg,
    uint8_t *data,
    uint8_t count
)
{
    Wire.beginTransmission(MPU_ADDR);

    Wire.write(reg);

    if (Wire.endTransmission(false) != 0)
    {
        return false;
    }

    uint8_t received =
        Wire.requestFrom(
            (uint8_t)MPU_ADDR,
            (uint8_t)count
        );

    if (received != count)
    {
        return false;
    }

    for (uint8_t i = 0; i < count; i++)
    {
        data[i] = Wire.read();
    }

    return true;
}

// ============================================================
// READ MPU9250
// ============================================================

bool readMPU()
{
    uint8_t data[14];

    if (
        !mpuReadRegisters(
            MPU_ACCEL_XOUT_H,
            data,
            14
        )
    )
    {
        return false;
    }

    int16_t axRaw =
        (int16_t)(
            ((uint16_t)data[0] << 8) |
            data[1]
        );

    int16_t ayRaw =
        (int16_t)(
            ((uint16_t)data[2] << 8) |
            data[3]
        );

    int16_t azRaw =
        (int16_t)(
            ((uint16_t)data[4] << 8) |
            data[5]
        );

    int16_t gxRaw =
        (int16_t)(
            ((uint16_t)data[8] << 8) |
            data[9]
        );

    int16_t gyRaw =
        (int16_t)(
            ((uint16_t)data[10] << 8) |
            data[11]
        );

    int16_t gzRaw =
        (int16_t)(
            ((uint16_t)data[12] << 8) |
            data[13]
        );

    // ±2g
    mpuAx = axRaw / 16384.0f;
    mpuAy = ayRaw / 16384.0f;
    mpuAz = azRaw / 16384.0f;

    // ±250 dps
    mpuGx = gxRaw / 131.0f;
    mpuGy = gyRaw / 131.0f;
    mpuGz = gzRaw / 131.0f;

    accelMagnitude =
        sqrtf(
            mpuAx * mpuAx +
            mpuAy * mpuAy +
            mpuAz * mpuAz
        );

    gyroMagnitude =
        sqrtf(
            mpuGx * mpuGx +
            mpuGy * mpuGy +
            mpuGz * mpuGz
        );

    return true;
}

// ============================================================
// INITIALIZE MPU
// ============================================================

bool initMPU()
{
    Serial.println();
    Serial.println(
        "[MPU9250] Initializing..."
    );

    uint8_t whoAmI = 0;

    if (
        !mpuReadRegisters(
            MPU_WHO_AM_I,
            &whoAmI,
            1
        )
    )
    {
        Serial.println(
            "[MPU9250] Communication FAILED"
        );

        return false;
    }

    Serial.print(
        "[MPU9250] WHO_AM_I: 0x"
    );

    Serial.println(
        whoAmI,
        HEX
    );

    if (
        !mpuWriteRegister(
            MPU_PWR_MGMT_1,
            0x00
        )
    )
    {
        Serial.println(
            "[MPU9250] Wake-up failed."
        );

        return false;
    }

    delay(100);

    // ±2g accelerometer
    mpuWriteRegister(
        MPU_ACCEL_CONFIG,
        0x00
    );

    // ±250 dps gyro
    mpuWriteRegister(
        MPU_GYRO_CONFIG,
        0x00
    );

    if (!readMPU())
    {
        Serial.println(
            "[MPU9250] Initial sensor read failed."
        );

        return false;
    }

    previousAccel =
        accelMagnitude;

    Serial.println(
        "[MPU9250] INITIALIZATION SUCCESS"
    );

    return true;
}

// ============================================================
// POSTURE DETECTION
// ============================================================

void detectPosture()
{
    if (!mpuAvailable)
    {
        posture = "UNKNOWN";
        return;
    }

    float ax = fabsf(mpuAx);
    float ay = fabsf(mpuAy);
    float az = fabsf(mpuAz);

    if (
        accelMagnitude <
        POSTURE_GRAVITY_MIN ||
        accelMagnitude >
        POSTURE_GRAVITY_MAX
    )
    {
        posture = "MOVING";
        return;
    }

    if (
        az > ax &&
        az > ay
    )
    {
        posture = "UPRIGHT";
    }
    else if (
        ax > ay &&
        ax > az
    )
    {
        posture = "SIDE";
    }
    else
    {
        posture = "LYING";
    }
}

// ============================================================
// MOTION DETECTION
// ============================================================

void detectMotion()
{
    float accelChange =
        fabsf(
            accelMagnitude -
            previousAccel
        );

    previousAccel =
        accelMagnitude;

    motionDetected =
        (
            accelChange >
            MOTION_ACCEL_THRESHOLD
        )
        ||
        (
            gyroMagnitude >
            MOTION_GYRO_THRESHOLD
        );
}

// ============================================================
// FALL DETECTION HELPERS
// ============================================================

void clearFallCandidate(const char *reason)
{
    freeFallDetected = false;
    impactDetected = false;
    fallConfirmationPending = false;
    fallStableSince = 0;
    freeFallTime = 0;
    impactTime = 0;

    if (reason != nullptr)
    {
        Serial.print("[FALL] ");
        Serial.println(reason);
    }
}

// ============================================================
// FALL DETECTION
// ============================================================

void detectFall()
{
    if (!mpuAvailable)
    {
        return;
    }

    const uint32_t now = millis();

    // 1. FREE FALL
    if (
        fallArmed &&
        !freeFallDetected &&
        !fallConfirmationPending &&
        accelMagnitude < FREEFALL_THRESHOLD
    )
    {
        freeFallDetected = true;
        freeFallTime = now;

        Serial.println();
        Serial.println(">>> FREE FALL DETECTED <<<");
    }

    // 2. IMPACT MUST FOLLOW A RECENT FREE FALL
    if (
        fallArmed &&
        freeFallDetected &&
        !impactDetected &&
        accelMagnitude > IMPACT_THRESHOLD
    )
    {
        impactDetected = true;
        freeFallDetected = false;

        impactTime = now;
        fallConfirmationPending = true;
        fallStableSince = 0;

        Serial.println(">>> IMPACT DETECTED <<<");
    }

    // 3. POST-IMPACT STABILITY
    if (fallConfirmationPending)
    {
        bool stableAfterImpact =
            accelMagnitude >= FALL_STABLE_ACCEL_MIN &&
            accelMagnitude <= FALL_STABLE_ACCEL_MAX &&
            gyroMagnitude <= FALL_STABLE_GYRO_MAX;

        if (stableAfterImpact)
        {
            if (fallStableSince == 0)
            {
                fallStableSince = now;
            }

            if (
                now - fallStableSince >=
                FALL_STILL_CONFIRM_MS
            )
            {
                // CONFIRMED FALL
                fallDetected = true;
                fallArmed = false;

                fallConfirmationPending = false;
                freeFallDetected = false;
                impactDetected = false;
                fallStableSince = 0;
                rearmStableSince = 0;

                fallSOSActive = true;
                fallBuzzerActive = true;
                fallBuzzerStartTime = now;

                digitalWrite(BUZZER_PIN, HIGH);

                Serial.println();
                Serial.println("========================================");
                Serial.println("        !!! FALL CONFIRMED !!!");
                Serial.println("        !!! SOS ACTIVE !!!");
                Serial.println("        !!! BUZZER ON !!!");
                Serial.println("        !!! 8 SECONDS !!!");
                Serial.println("========================================");
                Serial.println();
            }
        }
        else
        {
            fallStableSince = 0;
        }

        if (
            fallConfirmationPending &&
            now - impactTime >= IMPACT_CONFIRM_TIMEOUT_MS
        )
        {
            clearFallCandidate(
                "Impact confirmation timeout; candidate cleared."
            );
        }
    }

    // 4. FALSE FREE FALL
    if (
        freeFallDetected &&
        now - freeFallTime >= FALSE_FREEFALL_TIMEOUT_MS
    )
    {
        clearFallCandidate(
            "Free-fall candidate cleared."
        );
    }

    // 5. AUTOMATIC RE-ARM AFTER CONFIRMED FALL
    if (
        !fallArmed &&
        !freeFallDetected &&
        !impactDetected &&
        !fallConfirmationPending
    )
    {
        bool stable =
            accelMagnitude >= FALL_STABLE_ACCEL_MIN &&
            accelMagnitude <= FALL_STABLE_ACCEL_MAX &&
            gyroMagnitude <= FALL_STABLE_GYRO_MAX;

        if (stable)
        {
            if (rearmStableSince == 0)
            {
                rearmStableSince = now;
            }

            if (
                now - rearmStableSince >=
                FALL_REARM_STABLE_MS
            )
            {
                fallArmed = true;
                fallSOSActive = false;
                fallDetected = false;
                rearmStableSince = 0;

                Serial.println(
                    "[FALL] Detector re-armed. Fall SOS cleared."
                );
            }
        }
        else
        {
            rearmStableSince = 0;
        }
    }
}

// ============================================================
// TEMPERATURE
// ============================================================

void updateTemperature()
{
    if (!tempAvailable)
        return;

    if (millis() - lastTempRequest < TEMP_CONVERSION_TIME_MS)
        return;

    float newTemperature = tempSensor.getTempCByIndex(0);

    if (newTemperature != DEVICE_DISCONNECTED_C &&
        newTemperature > -55.0f &&
        newTemperature < 125.0f)
    {
        temperature = newTemperature;
    }
    else
    {
        Serial.println("[TEMP] Sensor read failed.");
    }

    tempSensor.requestTemperatures();
    lastTempRequest = millis();
}

// ============================================================
// MAX30100
// ============================================================

void updateMAX30100()
{
    if (!maxSensorAvailable)
        return;

    pox.update();

    if (millis() - lastMAXReport < REPORTING_PERIOD_MS)
        return;

    lastMAXReport = millis();

    float rawHeartRate = pox.getHeartRate();
    uint8_t rawSpO2 = pox.getSpO2();

    if (rawHeartRate >= 35.0f && rawHeartRate <= 220.0f)
        heartRate = rawHeartRate;

    if (rawSpO2 >= 70 && rawSpO2 <= 100)
        spo2 = rawSpO2;
}

// ============================================================
// WIFI & FIREBASE MAINTENANCE
// ============================================================

void connectWiFi()
{
    if (WiFi.status() == WL_CONNECTED)
        return;

    Serial.print("[WIFI] Connecting");
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

    uint32_t start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < 15000)
    {
        delay(250);
        Serial.print(".");
    }

    Serial.println();
    if (WiFi.status() == WL_CONNECTED)
    {
        Serial.println("[WIFI] Connected!");
        Serial.print("[WIFI] IP: ");
        Serial.println(WiFi.localIP());
    }
    else
    {
        Serial.println("[WIFI] Connection failed.");
    }
}

void maintainWiFi()
{
    if (WiFi.status() == WL_CONNECTED)
        return;

    if (millis() - lastWiFiReconnect < WIFI_RECONNECT_INTERVAL_MS)
        return;

    lastWiFiReconnect = millis();
    Serial.println("[WIFI] Reconnecting...");
    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
}

void initFirebase()
{
    config.api_key = API_KEY;
    config.database_url = DATABASE_URL;
    config.token_status_callback = tokenStatusCallback;

    auth.user.email = FIREBASE_USER_EMAIL;
    auth.user.password = FIREBASE_USER_PASSWORD;

    Firebase.begin(&config, &auth);
    Firebase.reconnectNetwork(true);

    Serial.println("[FIREBASE] Initialized.");
}

void uploadFirebase()
{
    if (WiFi.status() != WL_CONNECTED || !Firebase.ready())
        return;

    if (millis() - lastFirebaseUpload < FIREBASE_UPLOAD_INTERVAL_MS)
        return;

    lastFirebaseUpload = millis();

    FirebaseJson data;
    data.set("deviceId", DEVICE_ID);
    data.set("temperature", temperature);
    data.set("heartRate", heartRate);
    data.set("spo2", spo2);
    data.set("motion", motionDetected ? "YES" : "NO");
    data.set("posture", posture);
    data.set("fallDetected", fallDetected);
    data.set("freeFallDetected", freeFallDetected);
    data.set("impactDetected", impactDetected);
    data.set("fallSOSActive", fallSOSActive);
    data.set("fallBuzzerActive", fallBuzzerActive);
    data.set("fallArmed", fallArmed);
    data.set("sos", sosState);
    data.set("accelX", mpuAx);
    data.set("accelY", mpuAy);
    data.set("accelZ", mpuAz);
    data.set("gyroX", mpuGx);
    data.set("gyroY", mpuGy);
    data.set("gyroZ", mpuGz);
    data.set("accelMagnitude", accelMagnitude);
    data.set("gyroMagnitude", gyroMagnitude);
    data.set("max30100Available", maxSensorAvailable);
    data.set("mpu9250Available", mpuAvailable);
    data.set("wifiConnected", WiFi.status() == WL_CONNECTED);
    data.set("timestamp", millis());

    String path = String("/health_data/") + String(DEVICE_ID);

    bool result = Firebase.RTDB.setJSONAsync(&fbdo, path.c_str(), &data);

    if (!result)
    {
        Serial.print("[FIREBASE] Queue failed: ");
        Serial.println(fbdo.errorReason());
    }
}

// ============================================================
// SOS & BUZZER CONTROLS
// ============================================================

void updateSOSButton()
{
    bool currentRaw = (digitalRead(SOS_PIN) == LOW);

    if (currentRaw != rawSOSState)
    {
        rawSOSState = currentRaw;
        sosChangeTime = millis();
    }

    if (millis() - sosChangeTime >= SOS_DEBOUNCE_MS)
    {
        stableSOSState = rawSOSState;
    }
}

void updateBuzzer()
{
    if (stableSOSState)
    {
        digitalWrite(BUZZER_PIN, HIGH);
        return;
    }

    if (fallBuzzerActive)
    {
        if (millis() - fallBuzzerStartTime >= FALL_BUZZER_DURATION_MS)
        {
            fallBuzzerActive = false;
            digitalWrite(BUZZER_PIN, LOW);
            Serial.println("[FALL] Buzzer OFF after 8 seconds.");
        }
        else
        {
            digitalWrite(BUZZER_PIN, HIGH);
        }
        return;
    }

    digitalWrite(BUZZER_PIN, LOW);
}

void updateSOSState()
{
    sosState = stableSOSState || fallSOSActive;
    digitalWrite(LED_PIN, sosState ? HIGH : LOW);
}

// ============================================================
// LCD DISPLAY MANAGEMENT
// ============================================================

void writeLCD(String line1, String line2)
{
    if (!lcdAvailable)
        return;

    if (line1 == lastLCDLine1 && line2 == lastLCDLine2)
        return;

    lastLCDLine1 = line1;
    lastLCDLine2 = line2;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(line1.substring(0, 16));
    lcd.setCursor(0, 1);
    lcd.print(line2.substring(0, 16));
}

void updateLCD()
{
    if (millis() - lastLCDUpdate < REPORTING_PERIOD_MS)
        return;

    lastLCDUpdate = millis();

    String line1, line2;

    if (fallSOSActive)
    {
        line1 = "FALL! SOS ACTIVE";
        if (fallBuzzerActive)
        {
            uint32_t elapsed = millis() - fallBuzzerStartTime;
            uint32_t remaining = (elapsed < FALL_BUZZER_DURATION_MS)
                                ? (FALL_BUZZER_DURATION_MS - elapsed)
                                : 0;
            line2 = "BUZZER " + String((remaining + 999) / 1000) + " SEC";
        }
        else
        {
            line2 = "BUZZER OFF";
        }
    }
    else if (stableSOSState)
    {
        line1 = "MANUAL SOS";
        line2 = "BUZZER ON";
    }
    else
    {
        line1 = "HR:" + String((int)heartRate) + " Sp:" + String((int)spo2);
        line2 = String(temperature, 1) + "C " + posture;
    }

    writeLCD(line1, line2);
}

