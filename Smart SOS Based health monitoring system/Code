        Serial.print(mpuAx, 2); Serial.print(" ");
        Serial.print(mpuAy, 2); Serial.print(" ");
        Serial.println(mpuAz, 2);
        Serial.print("MPU Gyro    : ");
        Serial.print(mpuGx, 2); Serial.print(" ");
        Serial.print(mpuGy, 2); Serial.print(" ");
        Serial.println(mpuGz, 2);
    }
    Serial.println("----------------------------------------");
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
    Serial.begin(115200);
    while (!Serial && millis() < 3000);

    Serial.println();
    Serial.println("========================================");
    Serial.println("   ESP32 HEALTH & FALL MONITOR STARTING  ");
    Serial.println("========================================");

    // GPIO Setup
    pinMode(SOS_PIN, INPUT_PULLUP);
    pinMode(BUZZER_PIN, OUTPUT);
    pinMode(LED_PIN, OUTPUT);

    digitalWrite(BUZZER_PIN, LOW);
    digitalWrite(LED_PIN, LOW);

    // Initialize I2C Bus
    Wire.begin(I2C_SDA, I2C_SCL);
    scanI2CBus();

    // LCD Initialization
    if (i2cDevicePresent(LCD_ADDRESS))
    {
        lcd.init();
        lcd.backlight();
        lcdAvailable = true;
        writeLCD("Health Monitor", "Initializing...");
        Serial.println("[LCD] Initialized.");
    }
    else
    {
        Serial.println("[LCD] Not found on I2C bus.");
    }

    // Dallas Temp Initialization
    tempSensor.begin();
    if (tempSensor.getDS18Count() > 0)
    {
        tempAvailable = true;
        tempSensor.setWaitForConversion(false);
        tempSensor.requestTemperatures();
        lastTempRequest = millis();
        Serial.println("[DS18B20] Sensor initialized.");
    }
    else
    {
        Serial.println("[DS18B20] No sensor found.");
    }

    // MAX30100 Initialization
    if (i2cDevicePresent(MAX30100_ADDRESS))
    {
        Serial.print("[MAX30100] Initializing... ");
        if (pox.begin())
        {
            maxSensorAvailable = true;
            pox.setOnBeatDetectedCallback(onBeatDetected);
            Serial.println("SUCCESS");
        }
        else
        {
            Serial.println("FAILED");
        }
    }
    else
    {
        Serial.println("[MAX30100] Not found on I2C bus.");
    }

    // MPU9250 Initialization
    if (i2cDevicePresent(MPU_ADDR))
    {
        mpuAvailable = initMPU();
    }
    else
    {
        Serial.println("[MPU9250] Not found on I2C bus.");
    }

    // Network & Cloud Setup
    connectWiFi();
    initFirebase();

    if (lcdAvailable)
    {
        writeLCD("System Ready", DEVICE_ID);
    }

    Serial.println("[SYSTEM] Setup complete. Entering main loop.");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
    // High-frequency sensor updates
    updateMAX30100();

    if (mpuAvailable && readMPU())
    {
        detectMotion();
        detectPosture();
        detectFall();
    }

    // Periodic tasks & state machines
    updateTemperature();
    updateSOSButton();
    updateBuzzer();
    updateSOSState();
    updateLCD();

    // Connectivity & Cloud tasks
    maintainWiFi();
    uploadFirebase();

    // Diagnostic logging
    printStatus();
}
